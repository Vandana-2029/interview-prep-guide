# Copy this file to .env and fill in your own values. Never commit .env to GitHub.

# Port the API listens on
PORT=5000

# Your MongoDB connection string (local or MongoDB Atlas)
# Local:  mongodb://127.0.0.1:27017/a2z-journey
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/a2z-journey
MONGO_URI=mongodb://127.0.0.1:27017/a2z-journey

# A long random secret used to sign login tokens (JWT). Make your own:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Where the React app runs in development (for CORS)
CLIENT_URL=http://localhost:5173
